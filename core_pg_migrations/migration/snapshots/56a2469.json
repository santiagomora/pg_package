        "keep_snapshot_migration_ids": {
            "schema": "core_pg_migrations",
            "overloads": {
                "snapshot, int8[]": {
                    "overload": "\nCREATE OR REPLACE FUNCTION keep_snapshot_migration_ids (\n    p_snapshot snapshot, p_migration_ids int8[]\n) RETURNS void AS $$\nDECLARE\n    v_migration migration;\nBEGIN\n    PERFORM destroy_migration(m)\n    FROM migration m\n    WHERE snapshot_id = p_snapshot.id AND id != ALL(p_migration_ids);\nEND;\n$$ LANGUAGE plpgsql VOLATILE STRICT;\n",
                    "param_names": [
                        "p_snapshot",
                        "p_migration_ids"
                    ],
                    "param_types": [
                        "snapshot",
                        "int8[]"
                    ]
                }
