        "create_execution": {
            "comment": null,
            "kind": "function",
            "overloads": {
                "package, execution_action": {
                    "overload": "\nCREATE OR REPLACE FUNCTION create_execution (\n    p_package package,\n    p_action execution_action\n) RETURNS execution AS $$\nDECLARE \n    v_execution execution;\nBEGIN\n    INSERT INTO execution(package_id, created_at, action)\n    VALUES (p_package.id, now(), p_action)\n    RETURNING * INTO v_execution;\n    RETURN v_execution;\nEND;\n$$ LANGUAGE plpgsql VOLATILE STRICT;\n",
                    "param_names": [
                        "p_package",
                        "p_action"
                    ],
                    "param_types": [
                        "package",
                        "execution_action"
                    ]
                }
            },
            "schema": "core_pg_migrations",
            "type": {
                "schema": "core_pg_migrations",
                "type": "create_execution"
            }
        },
        "create_migration": {
            "comment": null,
            "kind": "function",
            "overloads": {
                "execution, text, text, text": {
                    "overload": "\nCREATE OR REPLACE FUNCTION create_migration (\n    p_execution execution,\n    p_name text,\n    p_snapshot text,\n    p_datafix_name text = NULL\n) RETURNS migration AS $$\nDECLARE \n    v_migration migration;\nBEGIN\n    INSERT INTO migration(execution_id, name, datafix_name, snapshot, created_at)\n    VALUES (p_execution.id, p_name, p_datafix_name, p_snapshot, now())\n    RETURNING * INTO v_migration;\n    RETURN v_migration;\nEND;\n$$ LANGUAGE plpgsql VOLATILE;\n",
                    "param_names": [
                        "p_execution",
                        "p_name",
                        "p_snapshot",
                        "p_datafix_name"
                    ],
                    "param_types": [
                        "execution",
                        "text",
                        "text",
                        "text"
                    ]
                }
            },
            "schema": "core_pg_migrations",
            "type": {
                "schema": "core_pg_migrations",
                "type": "create_migration"
            }
        },
        "create_package": {
            "comment": null,
            "kind": "function",
            "overloads": {
                "text, text, text": {
                    "overload": "\nCREATE OR REPLACE FUNCTION create_package (\n    p_name text,\n    p_branch_name text,\n    p_current_snapshot text\n) RETURNS package AS $$\nDECLARE \n    v_package package;\nBEGIN\n    INSERT INTO package(name, branch_name, current_snapshot, last_updated_at)\n    VALUES (p_name, p_branch_name, p_current_snapshot, now())\n    RETURNING * INTO v_package;\n    RETURN v_package;\nEND;\n$$ LANGUAGE plpgsql VOLATILE STRICT;\n",
                    "param_names": [
                        "p_name",
                        "p_branch_name",
                        "p_current_snapshot"
                    ],
                    "param_types": [
                        "text",
                        "text",
                        "text"
                    ]
                }
            },
            "schema": "core_pg_migrations",
            "type": {
                "schema": "core_pg_migrations",
                "type": "create_package"
            }
        },
